{
  "name": "cv-scan",
  "private": true,
  "workspaces": [
    "app"
  ],
  "dependencies": {
    "next": "16.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build && node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});fs.cpSync('app/.next','.next',{recursive:true});\"",
    "start": "npm --prefix app run start",
    "lint": "npm --prefix app run lint"
  }
}
