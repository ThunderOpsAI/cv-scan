{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thunderops.ai/schemas/pattern.schema.json",
  "title": "Project Pattern",
  "type": "object",
  "required": ["id", "name", "problem", "solution"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
