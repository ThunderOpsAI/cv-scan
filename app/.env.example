# ============================================================
# CVScan — Environment Variables
# ============================================================
# Copy this file to .env.local and replace placeholders locally.
# Never commit real credentials.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=your-nextauth-url

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe web payments
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_STARTER=your-stripe-starter-price-id
STRIPE_PRICE_PRO=your-stripe-pro-price-id
STRIPE_PRICE_ENTERPRISE=your-stripe-enterprise-price-id

# AI providers
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Google Play billing
GOOGLE_PLAY_PACKAGE_NAME=your-google-play-package-name
GOOGLE_PLAY_WEBHOOK_TOKEN=your-google-play-webhook-token
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=your-google-play-service-account-json

# Email
SMTP_HOST=your-smtp-host
SMTP_PORT=your-smtp-port
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=your-sender-address
