{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thunderops.ai/schemas/decision.schema.json",
  "title": "Project Decision",
  "type": "object",
  "required": ["id", "title", "status", "date"],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "superseded", "rejected"]
    },
    "date": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
